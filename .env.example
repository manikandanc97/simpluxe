# Cloudinary (image delivery)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=drdl4pdnx

# Site configuration
NEXT_PUBLIC_SITE_URL=https://simpluxe.in
NEXT_PUBLIC_CONTACT_EMAIL=connect@simpluxe.in
NEXT_PUBLIC_CONTACT_PHONE=+91 8675748207
NEXT_PUBLIC_WHATSAPP_NUMBER=+91 8675748207
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_GITHUB_URL=

# Lead capture: run supabase/leads.sql; set real values in .env.local and Vercel.
# Never put real secret keys in this example or use NEXT_PUBLIC_ for a secret.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Supported alternatives (the public URL from the Next.js connect dialog is fine):
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional; current server-only lead form does not use a publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enquiry email notifications (Resend free tier; no paid WhatsApp integration).
# Verify your sending domain in Resend before using the sender below.
RESEND_API_KEY=
LEAD_EMAIL_FROM=Simpluxe <connect@simpluxe.in>
LEAD_NOTIFY_EMAIL=connect@simpluxe.in
LEAD_REPLY_TO_EMAIL=connect@simpluxe.in
# Generate a random server secret; also store it in Supabase Vault for cron.
CRON_SECRET=
